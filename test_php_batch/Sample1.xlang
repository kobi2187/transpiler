        func demonstrateControlFlow
        | params:
            value: mixed
        | returns: string
        | body:
            if value is nil:
              return "null"

            else:
              return "other"


        func demonstrateLoops
        | returns: void
        | body:
            i = 0
            while i < 10:
echo(i)
ipost++

            j = 0
            while true:
echo(j)
jpost++
              if not j < 5:
                break


            k = 0
            while k < 10:
              if k is 5:
                continue

              if k is 8:
                break

echo(k)
kpost++


            items = {"a": 1, "b": 2, "c": 3}
            foreach (key, value) in items:
echo($(key) ++ ": " ++ $(value))

            foreach num in [1, 2, 3]:
echo(num)


        func demonstrateErrorHandling
        | returns: void
        | body:
            try:
              result = riskyOperation()

            catch e: InvalidArgumentException:
echo("Invalid argument: " ++ e.getMessage())

            catch e: RuntimeException | LogicException:
echo("Runtime or logic error: " ++ e.getMessage())

            catch e: Throwable:
echo("Unexpected error: " ++ e.getMessage())

            finally:
cleanup()

            value = if input != None:
input

else:
  raise InvalidArgumentException("Input required")

            file = @fopen("nonexistent.txt", "r")

        func demonstrateClosures
        | returns: void
        | body:
            greet = lambda(name: string) -> string:
  return "Hello, " ++ $(name) ++ "!"

            prefix = "Dear"
            formalGreet = lambda(name: string) -> string:
  return $(prefix) ++ " " ++ $(name)

            double = (x: int32) -> int32 => x * 2
            multiplier = 3
            multiply = (x) => x * multiplier
            numbers = [1, 2, 3, 4, 5]
            evens = array_filter(numbers, (n) => n % 2 is 0)
            doubled = array_map((n) => n * 2, numbers)
            sum = array_reduce(numbers, (carry, n) => carry + n, 0)

        func fibonacci
        | returns: Generator
        | body:
            a = 0
            b = 1
            while true:
              yield a
              (a, b) = [b, a + b]


        func indexedItems
        | params:
            items: array
        | returns: Generator
        | body:
            foreach (index, item) in items:
              yield strtoupper(item)


        func delegatingGenerator
        | returns: Generator
        | body:
            yield from [1, 2, 3]
            yield from fibonacci()

        enum Color
        | values:
            cRed = 16711680
            cGreen = 65280
            cBlue = 255

        class Shape
        | kind: class
        | members:
            func area
            | returns: float
            | body:

            func perimeter
            | returns: float
            | body:

            func describe
            | returns: string
            | body:
                return sprintf("%s: area=%.2f, perimeter=%.2f", typeof(static), self.area(), self.perimeter())

        class Circle
        | kind: class
        | base: Shape
        | members:
            ctor
            | params:
                radius: float
            | body:

            func area
            | returns: float
            | body:
                return M_PI * self.radius ** 2

            func perimeter
            | returns: float
            | body:
                return 2 * M_PI * self.radius

        func demonstrateSwitch
        | params:
            day: int32
        | returns: string
        | body:
            match day
            | 1:

              fallthrough            | 2:

              fallthrough            | 3:

              fallthrough            | 4:

              fallthrough            | 5:
                return "Weekday"

              fallthrough            | 6:

              fallthrough            | 7:
                return "Weekend"

              fallthrough            | _:
                return "Invalid"

