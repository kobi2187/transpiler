module Sample1.php
| source: php
| body:
    declare
      const strict_types = 1
    namespace App\Models
    | body:
        import App\Contracts\Renderable
        import App\Traits\HasTimestamps
        import App\Traits\SoftDeletes

        import App\Enums\Status
        const APP_VERSION = "1.0.0"
        ## Base model class demonstrating PHP 8.4 features
        class BaseModel
        | kind: class
        | members:
            const TABLE_PREFIX: string = "app_"
            id: string
            name: string = ""
            var instanceCount: int32 = 0
            ctor
            | params:
                createdAt: string = ""
                version: int32 = 1
            | body:
                self.id = uniqid()
self.instanceCountpost++

            dtor
            | body:
self.instanceCountpost--

            func getTableName
            | returns: string
            | body:

            func getId
            | returns: string
            | body:
                return self.id

        ## User model with modern PHP features
        class User
        | kind: class
        | base: BaseModel, Renderable
        | members:
            use HasTimestamps, SoftDeletes
            | adaptations:
                # alias: HasTimestamps::touch as touchTimestamp
                # precedence: SoftDeletes::delete insteadof HasTimestamps
            func getdisplayName
            | returns: string
            | body:
                return self.firstName ++ " " ++ self.lastName

            func setdisplayName
            | params:
                value: string
            | body:
                (self.firstName, self.lastName) = explode(" ", value, 2)


            email: string
            age: int32
            ctor
            | params:
                firstName: string
                lastName: string
                email: string
                age: int32
                roles: array = ["user"]
            | body:
parent.__construct()
                self.email = email
                self.age = age

            func getTableName
            | returns: string
            | body:
                return self.TABLE_PREFIX ++ "users"

            func toArray
            | returns: array | false
            | body:
                return {"id": self.getId(), "name": self.displayName, "email": self.email, "age": self.age, "roles": self.roles}

            func render
            | params:
                component: Renderable & Stringable
            | returns: string
            | body:
                return cast(component/string)

            func findRole
            | params:
                name: string
            | returns: Nullable<string>
            | body:
                foreach role in self.roles:
                  if role is name:
                    return role


                return nil

            static func create
            | params:
                args: string
            | returns: static
            | body:
                return static(... args)

            func getRoleMapper
            | returns: Closure
            | body:
                return strtoupper(...)

        concept Cacheable
        | body:
x.getCacheKey()
x.getCacheTtl()

        trait Loggable
        | members:
            logs: array = []
            func log
            | params:
                message: string
                level: string = "info"
            | returns: void
            | body:
                self.logs[] = {"message": message, "level": level, "timestamp": time()}

            func getLogs
            | returns: array
            | body:
                return self.logs

